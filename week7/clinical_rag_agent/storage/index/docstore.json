": "2026-05-18", "topic": "pharmacology"}}}, "docstore/data": {"e4726b0c-a448-4b19-b538-e6b79800241f": {"__data__": {"id_": "e4726b0c-a448-4b19-b538-e6b79800241f", "embedding": null, "metadata": {"file_path": "C:\\Users\\pitch\\ai410\\week7\\clinical_rag_agent\\data\\guidelines\\asthma_controller_stepup.txt", "file_name": "asthma_controller_stepup.txt", "file_type": "text/plain", "file_size": 250, "creation_date": "2026-05-18", "last_modified_date": "2026-05-18", "topic": "pulmonology"}, "excluded_embed_metadata_keys": ["file_name", "file_type", "file_size", "creation_date", "last_modified_date", "last_accessed_date"], "excluded_llm_metadata_keys": ["file_name", "file_type", "file_size", "creation_date", "last_modified_date", "last_accessed_date"], "relationships": {"1": {"node_id": "62f7af8c-28bb-49af-952f-5b1c4ed69093", "node_type": "4", "metadata": {"file_path": "C:\\Users\\pitch\\ai410\\week7\\clinical_rag_agent\\data\\guidelines\\asthma_controller_stepup.txt", "file_name": "asthma_controller_stepup.txt", "file_type": "text/plain", "file_size": 250, "creation_date": "2026-05-18", "last_modified_date": "2026-05-18", "topic": "pulmonology"}, "hash": "769543778161689dca9116d365ce1957db32e1fa5451084e881fd047bc9c01e6", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "Asthma controller therapy guidance:\r\n- Assess inhaler technique and adherence before stepping up treatment.\r\n- Frequent rescue inhaler use suggests poor control and requires reassessment.\r\n- Consider trigger avoidance and personalized action plans.", "mimetype": "text/plain", "start_char_idx": 0, "end_char_idx": 248, "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, "__type__": "1"}, "bafae450-0693-418e-8b3c-4df9fbb73be3": {"__data__": {"id_": "bafae450-0693-418e-8b3c-4df9fbb73be3", "embedding": null, "metadata": {"file_path": "C:\\Users\\pitch\\ai410\\week7\\clinical_rag_agent\\data\\guidelines\\chest_pain_triage.txt", "file_name": "chest_pain_triage.txt", "file_type": "text/plain", "file_size": 275, "creation_date": "2026-05-18", "last_modified_date": "2026-05-18", "topic": "cardiology"}, "excluded_embed_metadata_keys": ["file_name", "file_type", "file_size", "creation_date", "last_modified_date", "last_accessed_date"], "excluded_llm_metadata_keys": ["file_name", "file_type", "file_size", "creation_date", "last_modified_date", "last_accessed_date"], "relationships": {"1": {"node_id": "946b1851-4536-4934-b592-c7462e039985", "node_type": "4", "metadata": {"file_path": "C:\\Users\\pitch\\ai410\\week7\\clinical_rag_agent\\data\\guidelines\\chest_pain_triage.txt", "file_name": "chest_pain_triage.txt", "file_type": "text/plain", "file_size": 275, "creation_date": "2026-05-18", "last_modified_date": "2026-05-18", "topic": "cardiology"}, "hash": "7c9d86ef62df2fa54c385a420e4dad75f49626d120ad3e1c3d417614d6abfd1d", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "Chest pain triage guidance:\r\n- Severe chest pain with shortness of breath can indicate acute coronary syndrome.\r\n- Immediate emergency referral is recommended for ongoing pain, diaphoresis, or syncope.\r\n- Primary care follow-up is acceptable only when red flags are absent.", "mimetype": "text/plain", "start_char_idx": 0, "end_char_idx": 273, "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, "__type__": "1"}, "5839e01b-9002-4f8d-9e58-1a6c15426360": {"__data__": {"id_": "5839e01b-9002-4f8d-9e58-1a6c15426360", "embedding": null, "metadata": {"file_path": "C:\\Users\\pitch\\ai410\\week7\\clinical_rag_agent\\data\\guidelines\\diabetes_a1c_management.txt", "file_name": "diabetes_a1c_management.txt", "file_type": "text/plain", "file_size": 270, "creation_date": "2026-05-18", "last_modified_date": "2026-05-18", "topic": "endocrinology"}, "excluded_embed_metadata_keys": ["file_name", "file_type", "file_size", "creation_date", "last_modified_date", "last_accessed_date"], "excluded_llm_metadata_keys": ["file_name", "file_type", "file_size", "creation_date", "last_modified_date", "last_accessed_date"], "relationships": {"1": {"node_id": "e9dbf100-3ff3-456d-8062-2cb7230afcf4", "node_type": "4", "metadata": {"file_path": "C:\\Users\\pitch\\ai410\\week7\\clinical_rag_agent\\data\\guidelines\\diabetes_a1c_management.txt", "file_name": "diabetes_a1c_management.txt", "file_type": "text/plain", "file_size": 270, "creation_date": "2026-05-18", "last_modified_date": "2026-05-18", "topic": "endocrinology"}, "hash": "c5f4cccbfd925929899ac0772f30dfc9a8982a09462d03a6176d5b41b70b8674", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "Type 2 diabetes management guidance:\r\n- Hemoglobin A1c targets should be individualized based on comorbidity burden.\r\n- Review hypoglycemia history before treatment intensification.\r\n- Retinopathy and nephropathy screening should be completed at recommended intervals.", "mimetype": "text/plain", "start_char_idx": 0, "end_char_idx": 268, "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, "__type__": "1"}, "dacf7cb5-53f6-4f7c-be4f-d708be3767c0": {"__data__": {"id_": "dacf7cb5-53f6-4f7c-be4f-d708be3767c0", "embedding": null, "metadata": {"file_path": "C:\\Users\\pitch\\ai410\\week7\\clinical_rag_agent\\data\\guidelines\\hypertension_followup.txt", "file_name": "hypertension_followup.txt", "file_type": "text/plain", "file_size": 251, "creation_date": "2026-05-18", "last_modified_date": "2026-05-18", "topic": "cardiology"}, "excluded_embed_metadata_keys": ["file_name", "file_type", "file_size", "creation_date", "last_modified_date", "last_accessed_date"], "excluded_llm_metadata_keys": ["file_name", "file_type", "file_size", "creation_date", "last_modified_date", "last_accessed_date"], "relationships": {"1": {"node_id": "31dbb3ef-4992-4547-ae42-1a0cf3510c42", "node_type": "4", "metadata": {"file_path": "C:\\Users\\pitch\\ai410\\week7\\clinical_rag_agent\\data\\guidelines\\hypertension_followup.txt", "file_name": "hypertension_followup.txt", "file_type": "text/plain", "file_size": 251, "creation_date": "2026-05-18", "last_modified_date": "2026-05-18", "topic": "cardiology"}, "hash": "394770ca7359e20cc5dee1828abb6a398bda865a04860a6e74f90acf7f068237", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "Hypertension follow-up guidance:\r\n- Encourage home blood pressure monitoring with validated cuff devices.\r\n- Assess medication adherence and adverse effects at each visit.\r\n- Recommend lifestyle interventions including sodium reduction and exercise.", "mimetype": "text/plain", "start_char_idx": 0, "end_char_idx": 249, "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, "__type__": "1"}, "b4a7dbf5-1ba2-4001-857a-382f3b05e7de": {"__data__": {"id_": "b4a7dbf5-1ba2-4001-857a-382f3b05e7de", "embedding": null, "metadata": {"file_path": "C:\\Users\\pitch\\ai410\\week7\\clinical_rag_agent\\data\\guidelines\\warfarin_aspirin_interaction.txt", "file_name": "warfarin_aspirin_interaction.txt", "file_type": "text/plain", "file_size": 242, "creation_date": "2026-05-18", "last_modified_date": "2026-05-18", "topic": "pharmacology"}, "excluded_embed_metadata_keys": ["file_name", "file_type", "file_size", "creation_date", "last_modified_date", "last_accessed_date"], "excluded_llm_metadata_keys": ["file_name", "file_type", "file_size", "creation_date", "last_modified_date", "last_accessed_date"], "relationships": {"1": {"node_id": "af0b197e-536b-4cff-afc1-b09c383580d5", "node_type": "4", "metadata": {"file_path": "C:\\Users\\pitch\\ai410\\week7\\clinical_rag_agent\\data\\guidelines\\warfarin_aspirin_interaction.txt", "file_name": "warfarin_aspirin_interaction.txt", "file_type": "text/plain", "file_size": 242, "creation_date": "2026-05-18", "last_modified_date": "2026-05-18", "topic": "pharmacology"}, "hash": "a812ec3f1e671370f0da649fda7d22ab666c3bece0f3d353f8c1b38ebab7809e", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "Drug interaction guidance for warfarin and aspirin:\r\n- Combined use may increase bleeding risk.\r\n- Monitor INR closely and assess for gastrointestinal bleeding symptoms.\r\n- Escalate care if active bleeding, melena, or hematuria is reported.", "mimetype": "text/plain", "start_char_idx": 0, "end_char_idx": 240, "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, "__type__": "1"}}, "docstore/metadata": {"e4726b0c-a448-4b19-b538-e6b79800241f": {"doc_hash": "32f14a8b4b2d027887bf8484b20e78d810ec9d24f34159f71ea234858b8ec010", "ref_doc_id": "62f7af8c-28bb-49af-952f-5b1c4ed69093"}, "bafae450-0693-418e-8b3c-4df9fbb73be3": {"doc_hash": "34de2264884fdffae0b82e65ebb009d4a4a560ea9517cb848356fe75ce760046", "ref_doc_id": "946b1851-4536-4934-b592-c7462e039985"}, "5839e01b-9002-4f8d-9e58-1a6c15426360": {"doc_hash": "72ddd818fdabea880588e7a0fc12aadbeb4f1036dc5a82ba31676102a6589330", "ref_doc_id": "e9dbf100-3ff3-456d-8062-2cb7230afcf4"}, "dacf7cb5-53f6-4f7c-be4f-d708be3767c0": {"doc_hash": "88f8b1347c44f0aff8a0c8fa46b95c22fabb5fe5122fd9e4696a430bf12a4efd", "ref_doc_id": "31dbb3ef-4992-4547-ae42-1a0cf3510c42"}, "b4a7dbf5-1ba2-4001-857a-382f3b05e7de": {"doc_hash": "80b9727e1e94c8c3ffbbe91ef81d8fe12af1ed83c53dd25e9d0d94f7b5ed900c", "ref_doc_id": "af0b197e-536b-4cff-afc1-b09c383580d5"}}}